# Ālaya Claude Code hooks — configuration template.
#
# These are plain environment variables read by scripts/alaya-session-save.sh
# and scripts/alaya-precompact.sh. Set them any of the ways Claude Code
# subprocesses inherit env: your shell profile (~/.zshrc, ~/.bashrc), an env
# file you `source` before launching `claude`, or the top-level "env" key in
# ~/.claude/settings.json (or a project's .claude/settings.json).
#
# Copy the lines you need — don't source this file as-is, the example
# secret-manager commands below are illustrative, not runnable.

# --- Required: Ālaya store endpoint ---
ALAYA_URL="https://alaya.internal.example.com/store"

# Required: Ālaya bearer token (server auth is fail-closed — no key, no save).
# Direct value:
ALAYA_API_KEY="your-alaya-api-key"
# OR command-sourced — any command that prints the secret to stdout. The
# result is cached under ALAYA_HOOK_STATE_DIR for ALAYA_SECRET_CACHE_MINUTES
# so a slow secret manager isn't invoked on every Stop (LAB-1663). Example
# using a 1Password service account (`op://<vault>/<item>/<field>` — replace
# with your own vault path, this one does not exist):
# ALAYA_API_KEY_CMD='op read op://vault/alaya-config/credential'

# --- Required: LLM used for transcript extraction (any OpenAI chat-completions-compatible endpoint) ---
ALAYA_LLM_URL="https://llm-gateway.internal.example.com/v1/chat/completions"
ALAYA_LLM_MODEL="claude-haiku-4-5"    # default shown
ALAYA_LLM_API_KEY="your-llm-gateway-key"
# ALAYA_LLM_API_KEY_CMD='op read op://vault/llm-gateway-key/credential'

# --- Optional overrides (defaults shown) ---
# ALAYA_MIN_DURATION_SECS=120          # skip sessions shorter than this
# ALAYA_MIN_NEW_MESSAGES=5             # skip unless N+ new user messages since last save
# ALAYA_COOLDOWN_SECS=300              # skip if saved within this many seconds
# ALAYA_MEMORY_CAP=3                   # max memories stored per Stop
# ALAYA_DEDUP_THRESHOLD=0.70           # Alaya store dedup_threshold
# ALAYA_IMPORTANCE=0.7                 # Alaya store metadata.importance
# ALAYA_CLIENT_HOSTNAME=claude-code-hook
# ALAYA_HOOK_STATE_DIR="$HOME/.cache/alaya-hook"   # per-session save state + failures.log
# ALAYA_SECRET_CACHE_MINUTES=720       # 12h — how long a _CMD-resolved secret is cached
# ALAYA_PRECOMPACT_RECENT_LINES=500    # PreCompact: how far back to scan for a recent save
