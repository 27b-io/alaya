{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__alaya__store_memory",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/alaya-enforcer-line.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__alaya__memory_refute",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/alaya-enforcer-line.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__unified-memory__store",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/alaya-enforcer-line.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/alaya-session-save.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/alaya-precompact.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
