# Alaya docker-compose configuration.
# Copy to .env and customize.  docker compose reads .env automatically.

# ── TEI (Text Embeddings Inference) ─────────────────────────────
TEI_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
EMBEDDING_DIMENSIONS=1024
# Image tag. Defaults to cpu-arm64-latest (Mac dev). For x86 hosts use
# a pinned version like cpu-1.9.3 (no pinned ARM64 tags exist upstream).
# TEI_TAG=cpu-arm64-latest
# Only needed for gated HuggingFace models (this one is public):
# HUGGING_FACE_HUB_TOKEN=hf_...

# ── FalkorDB ────────────────────────────────────────────────────
GRAPH_NAME=memory_graph

# ── Qdrant ──────────────────────────────────────────────────────
QDRANT_COLLECTION=memories_arctic1024

# ── Auth (empty = disabled, fine for local dev) ─────────────────
GRAPH_API_KEY=
ALAYA_API_KEY=

# ── Summary (optional, requires Anthropic API key) ──────────────
# Also uncomment the SUMMARY_* env vars in docker-compose.yml.
# SUMMARY_API_KEY=sk-ant-...
# SUMMARY_MODEL=claude-haiku-4-5-20251001

# ── Logging ─────────────────────────────────────────────────────
RUST_LOG_BRIDGE=alaya_bridge=info
RUST_LOG_SERVER=alaya_server=info

# ── Build ───────────────────────────────────────────────────────
# GIT_SHA=dev
