# Alaya docker-compose configuration.
# Copy to .env and customize.  docker compose reads .env automatically.

# ── TEI (Text Embeddings Inference) ─────────────────────────────
TEI_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
EMBEDDING_DIMENSIONS=1024
# Image tag. Defaults to cpu-arm64-latest (Mac dev). For x86 hosts use
# a pinned version like cpu-1.9.3 (no pinned ARM64 tags exist upstream).
# TEI_TAG=cpu-arm64-latest
# Only needed for gated HuggingFace models (this one is public):
# HUGGING_FACE_HUB_TOKEN=hf_...

# ── FalkorDB ────────────────────────────────────────────────────
GRAPH_NAME=memory_graph

# ── Qdrant ──────────────────────────────────────────────────────
QDRANT_COLLECTION=memories_arctic1024

# ── Auth ────────────────────────────────────────────────────────
# The server is FAIL-CLOSED: it refuses to boot with no auth. For local dev,
# docker-compose.yml sets DANGEROUSLY_ALLOW_UNAUTHENTICATED=true (localhost
# only — the open mode is refused on any public PUBLIC_BASE_URL). Set
# ALAYA_API_KEY to a real token to enable auth (which auto-disables the
# dev-open flag). GRAPH_API_KEY guards the FalkorDB bridge.
GRAPH_API_KEY=
ALAYA_API_KEY=
# Optional second bearer for headless read-only consumers (pure reads only,
# 403 on every mutating route incl. /store). Must differ from ALAYA_API_KEY.
ALAYA_READONLY_API_KEY=
# Before exposing beyond localhost: set ALAYA_API_KEY above, and override
#   DANGEROUSLY_ALLOW_UNAUTHENTICATED=false
#   PUBLIC_BASE_URL=https://your-host.example.com

# ── Cross-encoder reranker (opt-in) ─────────────────────────────
# Start with: docker compose --profile rerank up -d
# Then uncomment RERANK_URL to point alaya-server at the tei-rerank service.
# RERANK_URL=http://tei-rerank:80
# RERANK_API_KEY=
# RERANK_TOP_N=20
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── Summary (optional, requires Anthropic API key) ──────────────
# Also uncomment the SUMMARY_* env vars in docker-compose.yml.
# SUMMARY_API_KEY=sk-ant-...
# SUMMARY_MODEL=claude-haiku-4-5-20251001

# ── OAuth Resource Server (optional, delegated auth via OIDC) ───
# Also uncomment OIDC_ISSUER in docker-compose.yml.
# OIDC_ISSUER=https://your-idp.example.com

# ── Logging ─────────────────────────────────────────────────────
RUST_LOG_BRIDGE=alaya_bridge=info
RUST_LOG_SERVER=alaya_server=info

# ── Build ───────────────────────────────────────────────────────
# GIT_SHA=dev
